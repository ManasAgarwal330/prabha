# Copy to .env for local development. In production set the same names in
# Netlify → Site configuration → Environment variables. Never commit .env.

# --- Backend (server only — never exposed to the browser) ---------------------
# Azure Cosmos DB (NoSQL API) → Settings → Keys → PRIMARY CONNECTION STRING.
# Required — all content and enquiries live here.
NUXT_COSMOS_CONNECTION_STRING=
NUXT_COSMOS_DATABASE=pravaah
# Seconds content stays in memory between database reads. 0 = read on every request.
NUXT_CONTENT_CACHE_SECONDS=60

# --- Public (sent to the browser) --------------------------------------------
NUXT_PUBLIC_SITE_URL=https://pravaah-travel.netlify.app
# The Blob Storage container URL printed by `npm run images:upload`, e.g.
# https://<account>.blob.core.windows.net/images — required: the photos exist only in Storage.
NUXT_PUBLIC_IMAGE_BASE_URL=

# --- Scripts only — not needed on Netlify -----------------------------------
# RU/s of manual throughput shared by all containers, applied by `npm run db:setup`.
# Needs a provisioned-throughput account (not serverless). Min 400, steps of 100.
COSMOS_THROUGHPUT=1000
# npm run images:upload: Storage account → Security + networking → Access keys.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=images
